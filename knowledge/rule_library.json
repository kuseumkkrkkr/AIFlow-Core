{
  "version": "2026.07.25-alpha",
  "rules": [
    {
      "rule_id": "hs1_function_value",
      "name": "함숫값 대입",
      "domain": "hs1_function_basic",
      "lhs": "f(x)=...",
      "rhs": "f(a)=...",
      "conditions": {"tags": ["함수", "함숫값"], "requires": ["function_expression", "input"]},
      "inverse": "evaluate_function",
      "risk": "medium",
      "notes_kr": "정의역 조건을 먼저 확인한 뒤 입력값을 대입한다."
    },
    {
      "rule_id": "hs1_function_composition",
      "name": "합성함수 대입",
      "domain": "hs1_function_composition",
      "lhs": "f(g(x))",
      "rhs": "f(g(x))=a(cx+d)+b",
      "conditions": {"tags": ["합성함수"], "requires": ["a", "b", "c", "d", "input"]},
      "inverse": "evaluate_inner_first",
      "risk": "low",
      "notes_kr": "안쪽 함수 g를 먼저 계산한 뒤 바깥 함수 f에 대입한다."
    },
    {
      "rule_id": "hs1_inverse_function",
      "name": "일차함수 역함수",
      "domain": "hs1_inverse_function",
      "lhs": "f(x)=ax+b",
      "rhs": "f^-1(x)=(x-b)/a",
      "conditions": {"tags": ["역함수"], "requires": ["a", "b"]},
      "inverse": "reverse_mapping",
      "risk": "low",
      "notes_kr": "a는 0이 아니어야 하며 x와 y를 바꾼 뒤 정리한다."
    },
    {
      "rule_id": "hs1_conditional_probability",
      "name": "조건부확률 정의",
      "domain": "hs1_conditional_probability",
      "lhs": "P(A|B)",
      "rhs": "P(A∩B)/P(B)",
      "conditions": {"tags": ["조건부확률"], "requires": ["joint", "condition"]},
      "inverse": "divide_by_condition",
      "risk": "medium",
      "notes_kr": "P(B)가 0이 아닌지 확인한다."
    },
    {
      "rule_id": "hs1_factor_remainder",
      "name": "인수정리",
      "domain": "hs1_polynomial_factor",
      "lhs": "P(a)=0",
      "rhs": "(x-a)는 P(x)의 인수",
      "conditions": {"tags": ["인수정리"], "requires": ["polynomial", "candidate"]},
      "inverse": "factor_polynomial",
      "risk": "medium",
      "notes_kr": "후보 근을 대입해 나머지가 0인지 검산한다."
    },
    {
      "rule_id": "linear_balance",
      "name": "일차방정식 등식 보존",
      "domain": "cm_linear",
      "lhs": "a*x+b=c",
      "rhs": "x=(c-b)/a",
      "conditions": {"tags": ["일차방정식"], "requires": ["a", "b", "c"]},
      "inverse": "substitute_x",
      "risk": "low",
      "notes_kr": "a가 0이면 일차방정식이 아니므로 거부한다."
    },
    {
      "rule_id": "ratio_scale",
      "name": "비례식 비율 보존",
      "domain": "cm_ratio",
      "lhs": "a:b=c:d",
      "rhs": "a*d=b*c",
      "conditions": {"tags": ["비례"], "requires": ["numbers"]},
      "inverse": "solve_missing_ratio",
      "risk": "low",
      "notes_kr": "비례식은 양변의 교차곱으로 검산한다."
    },
    {
      "rule_id": "probability_basic",
      "name": "확률의 기본 정의",
      "domain": "cm_probability",
      "lhs": "P(E)",
      "rhs": "favorable/total",
      "conditions": {"tags": ["확률"], "requires": ["numbers"]},
      "inverse": "count_events",
      "risk": "medium",
      "notes_kr": "동일한 가능성을 갖는 유한 표본공간에서만 적용한다."
    },
    {
      "rule_id": "pythagorean_identity",
      "name": "피타고라스 정리",
      "domain": "cm_geometry",
      "lhs": "a²+b²",
      "rhs": "c²",
      "conditions": {"tags": ["피타고라스"], "requires": ["numbers"]},
      "inverse": "solve_side",
      "risk": "low",
      "notes_kr": "c는 직각삼각형의 빗변이어야 한다."
    },
    {
      "rule_id": "ar_seq_an_formula",
      "name": "등차수열 일반항",
      "domain": "cm_arith_sequence",
      "lhs": "a_n",
      "rhs": "a1 + (n - 1) * d",
      "conditions": {
        "tags": ["수열", "등차수열"],
        "requires": ["a1", "d", "n"]
      },
      "inverse": "a_n_to_a1d",
      "risk": "low",
      "notes_kr": "n 입력이 없으면 n=1 기준 기본값으로 폴백."
    },
    {
      "rule_id": "ar_gp_an_formula",
      "name": "등비수열 일반항",
      "domain": "cm_arith_sequence",
      "lhs": "a_n",
      "rhs": "a1 * (r)^(n - 1)",
      "conditions": {
        "tags": ["수열", "등비수열"],
        "requires": ["a1", "r", "n"]
      },
      "inverse": "an_to_a1r",
      "risk": "low",
      "notes_kr": "음수 지수 입력은 문제 생성에서 제한."
    },
    {
      "rule_id": "set_union_identity",
      "name": "합집합 공식",
      "domain": "cm_set",
      "lhs": "|A∪B|",
      "rhs": "|A| + |B| - |A∩B|",
      "conditions": {
        "tags": ["집합", "합집합", "교집합"],
        "requires": ["|A|", "|B|", "|A∩B|"]
      },
      "inverse": "intersection_from_union",
      "risk": "low",
      "notes_kr": "전제: 유한 집합의 크기 양의 정수."
    },
    {
      "rule_id": "quad_delta_root",
      "name": "이차방정식 판별식",
      "domain": "cm_quadratic",
      "lhs": "ax²+bx+c=0",
      "rhs": "D = b² - 4ac",
      "conditions": {
        "tags": ["이차방정식", "판별식"],
        "requires": ["a", "b", "c"]
      },
      "inverse": "solve_from_delta",
      "risk": "medium",
      "notes_kr": "복소근 허용 여부는 도메인 제약에서 지정."
    },
    {"rule_id":"hs1_exponential_log_basic","name":"지수·로그 기본 계산","domain":"hs1_exponential_log","lhs":"a^n 또는 log_a b","rhs":"정수 지수 계산","conditions":{"tags":["지수","로그"],"requires":["kind"]},"inverse":"evaluate_power_log","risk":"low","notes_kr":"밑과 진수가 양수인지 확인한다."},
    {"rule_id":"hs1_exponential_equation_basic","name":"지수·로그 방정식","domain":"hs1_exponential_equation","lhs":"a^(mx+p)=b^(nx+q), a^x=b 또는 log_a x=c","rhs":"밑변환 후 x=(q·log_a(b)-p)/(m-n·log_a(b))","conditions":{"tags":["지수방정식","로그방정식"],"requires":["kind"]},"inverse":"solve_exponential_equation","risk":"medium","notes_kr":"밑은 0보다 크고 1이 아니며 해를 원식 양변에 재대입한다."},
    {"rule_id":"hs1_special_angle_trig","name":"특수각 삼각함수","domain":"hs1_trigonometry","lhs":"sin/cos/tan θ","rhs":"특수각 표","conditions":{"tags":["삼각함수"],"requires":["kind","angle"]},"inverse":"evaluate_special_angle","risk":"low","notes_kr":"도 단위 특수각만 지원한다."},
    {"rule_id":"hs2_polynomial_limit","name":"다항함수 극한·이차 차분몫","domain":"hs2_limit","lhs":"lim x→a P(x) 또는 lim x→a (f(x)-f(a))/(x-a)","rhs":"P(a) 또는 f'(a)","conditions":{"tags":["극한"],"requires":["point","kind"]},"inverse":"substitute_or_difference_quotient","risk":"medium","notes_kr":"현재는 x²+3x 대입과 이차다항식 차분몫만 실행하며, 해는 독립 차분 검산을 통과해야 한다."},
    {"rule_id":"hs2_power_derivative","name":"다항식 도함수값·극값","domain":"hs2_derivative","lhs":"(x^n)', ((ax+b)(cx²+dx+e))', Ax³+ax+C의 극대 조건","rhs":"거듭제곱·곱의 미분법 또는 f'(r)=0, f''(r)<0","conditions":{"tags":["미분"],"requires":["input"]},"inverse":"power_rule_product_rule_or_stationary_point","risk":"low","notes_kr":"현재는 거듭제곱 단항식, 정수 계수 일차식×이차식의 특정 점 도함수, Ax³+ax+C의 극대·극솟값만 독립 불변식으로 검산한다."},
    {"rule_id":"hs2_tangent_slope","name":"접선 기울기","domain":"hs2_tangent","lhs":"f'(a)","rhs":"접선의 기울기","conditions":{"tags":["접선"],"requires":["power","input"]},"inverse":"differentiate_at_point","risk":"medium","notes_kr":"미분계수는 해당 점에서의 접선 기울기다."},
    {"rule_id":"hs2_power_integral","name":"거듭제곱 정적분","domain":"hs2_integral","lhs":"∫a^b x^n dx","rhs":"[x^(n+1)/(n+1)]_a^b","conditions":{"tags":["적분"],"requires":["lower","upper","power"]},"inverse":"power_integral","risk":"medium","notes_kr":"구간 상한과 하한을 대입해 넓이를 계산한다."},
    {"rule_id":"hs_composite_sequence","name":"등차수열 두 항 결합","domain":"hs_composite_sequence","lhs":"a_p+a_q","rhs":"(a1+(p-1)d)+(a1+(q-1)d)","conditions":{"tags":["복합중"],"requires":["a1","d","n1","n2"]},"inverse":"sum_two_arithmetic_terms","risk":"medium","notes_kr":"일반항을 두 번 적용한 뒤 두 항을 더한다."},
    {"rule_id":"hs_composite_sequence_function","name":"수열·함수·지수로그 결합","domain":"hs_composite_sequence_function","lhs":"log_2(2^(f(g(x))))","rhs":"f(g(x))","conditions":{"tags":["복합상"],"requires":["a1","d","n1","n2","f_a","f_b","input"]},"inverse":"solve_sequence_function_log_chain","risk":"high","notes_kr":"수열 일반항, 함수 대입, 지수·로그 역연산을 순서대로 적용한다."},
    {"rule_id":"hs1_geometric_sequence","name":"등비수열 일반항·합","domain":"hs1_geometric_sequence","lhs":"a_n 또는 S_n","rhs":"a_1r^(n-1), a_1(r^n-1)/(r-1)","conditions":{"tags":["등비수열","공비"],"requires":["a1","ratio","n"]},"inverse":"evaluate_geometric_sequence","risk":"low","notes_kr":"공비가 1인 경우는 S_n=na_1로 별도 처리한다."},
    {"rule_id":"stat_binomial_distribution","name":"이항분포 확률","domain":"stat_binomial_distribution","lhs":"P(X=k)","rhs":"nCk p^k(1-p)^(n-k)","conditions":{"tags":["이항분포"],"requires":["n","p","k"]},"inverse":"evaluate_binomial_probability","risk":"medium","notes_kr":"시행 횟수 n과 성공확률 p, 성공 횟수 k의 범위를 먼저 확인한다."},
    {"rule_id":"geo_vector_dot","name":"평면벡터 내적","domain":"geo_vector_dot","lhs":"a·b","rhs":"a_xb_x+a_yb_y","conditions":{"tags":["벡터","내적"],"requires":["x1","y1","x2","y2"]},"inverse":"sum_component_products","risk":"low","notes_kr":"두 벡터가 같은 좌표계의 평면 성분으로 주어진 경우에 적용한다."},
    {"rule_id":"cal_trig_derivative","name":"삼각함수 미분","domain":"cal_trig_derivative","lhs":"(sin x)' 또는 (cos x)'","rhs":"cos x 또는 -sin x","conditions":{"tags":["삼각함수 미분"],"requires":["kind","input"]},"inverse":"differentiate_trigonometric_function","risk":"medium","notes_kr":"입력 각도는 라디안으로 해석한다."},
    {"rule_id":"polynomial_remainder_two_linear","name":"두 일차식 나머지 보간","domain":"hs_polynomial_remainder","lhs":"R(r1), R(r2)","rhs":"일차 나머지 R(x)의 두 점 보간","conditions":{"tags":["나머지정리"],"requires":["root1","remainder1","root2","remainder2","point"]},"inverse":"polynomial_remainder_two_linear","risk":"medium","notes_kr":"서로 다른 두 일차식으로 나눈 나머지에서 이차식 나머지를 결정한다."},
    {"rule_id":"rational_interval_extrema","name":"유리함수 구간 극값","domain":"hs_rational_interval_extrema","lhs":"a/(x-c)+b","rhs":"구간 양 끝점의 함수값 연립","conditions":{"tags":["유리함수","최댓값","최솟값"],"requires":["shift","left","right","maximum","minimum"]},"inverse":"rational_interval_extrema","risk":"medium","notes_kr":"a>0과 분모가 0이 아닌 단조 구간에서만 적용한다."},
    {"rule_id":"symbolic_matrix_product_2x2","name":"미지수를 포함한 2×2 행렬 곱","domain":"hs_matrix_product","lhs":"AB","rhs":"(AB)_ij=Σ A_itB_tj","conditions":{"tags":["행렬","행렬의 곱"],"requires":["left","right","targets","requested"]},"inverse":"symbolic_matrix_product_2x2","risk":"medium","notes_kr":"양의 정수 k 하나를 포함한 2×2 행렬 곱 조건을 대입·검산한다."}
  ]
}
